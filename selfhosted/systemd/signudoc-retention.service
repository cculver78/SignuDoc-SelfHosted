[Unit]
Description=Run SignuDoc retention and notification job
Wants=network-online.target
After=network-online.target signudoc.service

[Service]
Type=oneshot
User=signudoc-retention
Group=signudoc
WorkingDirectory=/opt/signudoc/current
EnvironmentFile=/etc/signudoc/retention.env
RuntimeDirectory=signudoc-retention
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/test -L /opt/signudoc/current
ExecStartPre=/usr/bin/test ! -e /var/lib/signudoc/deployment-incomplete
ExecStart=/opt/signudoc/current/selfhosted/scripts/run-retention.sh
TimeoutStartSec=5min
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=/var/lib/signudoc/documents
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
