# Copy to /etc/signudoc/signudoc.env, replace every placeholder, and keep mode 0600.
NODE_ENV=production
APP_URL=https://signudoc.example.com
BETTER_AUTH_URL=https://signudoc.example.com
BETTER_AUTH_SECRET=replace-with-64-hex-secret

DATABASE_URL=replace-with-postgresql-connection-url
PORT=3000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/signudoc/documents

EMAIL_DRIVER=smtp
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# SMTP_USER and SMTP_PASSWORD are optional; configure both or neither.
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM_EMAIL=replace-with-sender@example.invalid
SUPPORT_EMAIL=replace-with-support@example.invalid

SETUP_TOKEN=replace-with-64-hex-secret

# In production password breach checking is enabled unless explicitly set to off.
# PASSWORD_BREACH_CHECK=off

# Optional customer supplied signing certificate. Leave both unset to use the
# application-managed certificate stored encrypted in PostgreSQL.
# SEAL_P12_BASE64=
# SEAL_P12_PASSWORD=
